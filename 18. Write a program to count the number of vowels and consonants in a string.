void main() {
  String str = "Hello World";
  int vowels = 0;
  int consonants = 0;

  for (int i = 0; i < str.length; i++) {
    String ch = str[i].toLowerCase();

    if ("aeiou".contains(ch)) {
      vowels++;
    } else if (RegExp(r'[a-z]').hasMatch(ch)) {
      consonants++;
    }
  }

  print("Vowels = $vowels");
  print("Consonants = $consonants");
}
